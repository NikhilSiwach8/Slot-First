{
  "name": "shadowplay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SHADOWPLAY \u2014 The All Hallows' Paper Theatre. A 6\u00d75 ways slot built around Light & Shadow (demo credits only).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate": "tsx scripts/simulate.ts",
    "assets": "python3 -I scripts/art/export_web.py",
    "test:e2e": "playwright test",
    "books": "tsx scripts/export-books.ts",
    "books:verify": "tsx scripts/verify-books.ts",
    "build:stake": "tsc --noEmit && vite build --outDir stake/frontend --emptyOutDir"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
